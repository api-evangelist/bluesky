            },
            "url": {
              "path": [
                "xrpc",
                "com.atproto.label.queryLabels"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "uriPatterns",
                  "value": "<string>",
                  "description": "(Required) List of AT URI patterns to match (boolean 'OR'). Each may be a prefix (ending with '*'; will match inclusive of the string leading to '*'), or a full URI."
